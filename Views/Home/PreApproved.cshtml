<!--menu link-->
@using System.Linq
@model List<part1_poe.Models.pre_approve>
@Html.Partial("_menu")

<!--internal styling-->
<style>
    .claims_container {
        width: 97%;
        margin: 40px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
    }

    h2 {
        text-align: start;
        margin-bottom: 20px;
        color: #111827;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        background-color: #0b1f4a;
        color: #ffffff;
    }

        table thead {
            background-color: #06224d;
            color: #ffffff;
        }

        table th, table td {
            padding: 12px;
            text-align: center;
            border: none;
        }

        table tr:nth-child(even) {
            background-color: #122b64;
        }

    .btn {
        padding: 6px 12px;
        text-decoration: none;
        background: #1e4fa3;
        color: white;
        border-radius: 6px;
        font-size: 14px;
    }

        .btn:hover {
            background: #3a74d8;
        }

    .status {
        font-weight: bold;
        padding: 6px 12px;
        border-radius: 6px;
    }

        .status.pre-approved {
            color: #28a745;
        }


    /* Footer */
    .footer {
        width: 95.6%;
        text-align: center;
        padding: 2rem;
        background-color: #0d1b2a;
        color: white;
        margin-top: 5rem;
    }

        .footer h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .footer p {
            font-size: 0.95rem;
            max-width: 800px;
            margin: 0 auto 1.5rem auto;
            color: #dbe2ef;
        }

        .footer .icons i {
            font-size: 1.2rem;
            margin: 0 10px;
            color: #3f88c5;
            transition: transform 0.3s, color 0.3s;
        }

            .footer .icons i:hover {
                transform: scale(1.2);
                color: #90e0ef;
            }
</style>


<!--creating the pre-approved claims table-->
<div class="claims_container">
    <h2>Pre-Approved Claims</h2>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Lecturer</th>
                <th>Module</th>
                <th>Faculty</th>
                <th>Total Amount</th>
                <th>Supporting Document</th>
                <th>Status</th>
                <th>Date Submitted</th>
                <th>Action</th> 
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (var claim in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@claim.names</td>
                        <td>@claim.ModuleName</td>
                        <td>@claim.FacultyName</td>
                        <td>R @claim.TotalAmount</td>
                        <td>
                            @if (!string.IsNullOrEmpty(claim.SupportingDocument))
                            {
                                <a href="@Url.Content("~/files/" + claim.SupportingDocument)" class="btn" target="_blank">View</a>
                            }
                            else
                            {
                                <span>No File</span>
                            }
                        </td>
                        <td>
                            <span class="status @(claim.ClaimStatus.ToLower())">@claim.ClaimStatus</span>
                        </td>
                        <td>@claim.CreatingDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (claim.ClaimStatus.ToLower() == "pending")
                            {
                                <a asp-action="PreApproveClaim" asp-route-id="@claim.ClaimID" class="btn" style="margin-right:5px;">Pre-Approve</a>
                                <a asp-action="RejectClaim" asp-route-id="@claim.ClaimID" class="btn btn-danger">Reject</a>
                            }
                            else
                            {
                                <span></span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align:center;">No claims found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!--footer-->
<div style="height: 6.5rem; width:100%;"></div>
<div class="footer">
    <hr />
    <h3>About Us</h3>
    <p>At LayeredLogic,<br> We transform visions into reality through web applications and unwavering commitment to excellence.<br></p>
    <div class="icons">
        <i class="fa-brands fa-facebook"></i>
        <i class="fa-brands fa-instagram"></i>
        <i class="fa-brands fa-linkedin"></i>
        <i class="fa-brands fa-telegram"></i>
    </div>
    <br />
    copyright <i class="fa-regular fa-copyright"></i> 2025, Contract Monthly Claim System (CMCS) | Created by Matlhaga Amogelang
</div>