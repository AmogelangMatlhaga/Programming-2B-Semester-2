<!--icon link-->
@model part1_poe.Models.submit_claims

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


@Html.Partial("_Menu")

<!-- creating the lecturer dashboard -->
<!--internal styling-->
<style>

    .form-row {
        display: flex;
        gap: 20px;
        width: 100%;
        flex-wrap: wrap;
    }

    .form-group {
        flex: 1;
        min-width: 45%;
    }

    .contain_claim {
        text-align: center;
        display: block;
        width: 100%;
        margin-top: 40px;
    }

    .claim_form {
        display: flex;
        flex-wrap: wrap;
        width: 90%;
        margin: auto;
        text-align: start;
        box-sizing: border-box;
        border-radius: 10px;
        padding: 20px;
        background-color: white;
        transition: 0.5s;
        border-color: dodgerblue;
    }

        .claim_form label {
            width: 100%;
            margin-top: 20px;
            font-weight: bold;
            color: black;
        }

        .claim_form input,
        .claim_form select {
            height: 2rem;
            width: 100%;
            border-radius: 5px;
            background-color: white;
            color: #046df6;
            border: 1px solid skyblue;
            margin-top: 5px;
            padding: 5px;
        }

        .claim_form h2 {
            width: 100%;
            text-align: center;
            font-family: Georgia, 'Times New Roman', Times, serif;
            margin-bottom: 1rem;
        }

    /* Footer */
    .footer {
        width: 95.6%;
        text-align: center;
        padding: 2rem;
        background-color: #0d1b2a;
        color: white;
        margin-top: 5rem;
    }

        .footer h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .footer p {
            font-size: 0.95rem;
            max-width: 800px;
            margin: 0 auto 1.5rem auto;
            color: #dbe2ef;
        }

        .footer .icons i {
            font-size: 1.2rem;
            margin: 0 10px;
            color: #3f88c5;
            transition: transform 0.3s, color 0.3s;
        }

            .footer .icons i:hover {
                transform: scale(1.2);
                color: #90e0ef;
            }

</style>


<div class="contain_claim">
    <form class="claim_form" asp-action="SubmitClaim" method="post" enctype="multipart/form-data">
        <h2>
            <i class="fa fa-folder-open" style="font-size:5rem;color:#046df6;"></i><br />
            Submit Your Claim
        </h2>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Sessions"></label>
                <input type="number" asp-for="Sessions" onmouseout="total_calculate()" class="form-control" />
                <span asp-validation-for="Sessions" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hours"></label>
                <input type="number" asp-for="Hours" class="form-control" />
                <span asp-validation-for="Hours" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Rate"></label>
                <input type="number" asp-for="Rate" onmouseout="total_calculate()" class="form-control" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalAmount"></label>
                <input type="number" asp-for="TotalAmount" class="form-control" readonly />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Module"></label>
                <input type="text" asp-for="Module" class="form-control" />
                <span asp-validation-for="Module" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Faculty"></label>
                <input type="text" asp-for="Faculty" class="form-control" />
                <span asp-validation-for="Faculty" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Documents"></label>
                <input type="file" asp-for="Documents" class="form-control" />
                <span asp-validation-for="Documents" class="text-danger"></span>
            </div>
        </div>


        <div class="form-row">
            <div class="form-group">
              
                <span  class="text-danger">@ViewBag.message</span>
            </div>
        </div>
        <input type="submit" value="Submit Claim" class="button_claim" />
    </form>
</div>

<script>
    function total_calculate() {
        var sessionNumber = document.getElementById("Sessions").value;
        var rateAmount = document.getElementById("Rate").value;
        var Total = Number(sessionNumber) * Number(rateAmount);
        document.getElementById("TotalAmount").value = Total;
    }
</script>


    <partial name="_ValidationScriptsPartial" />
<!--Footer --> 
<div style="height: 6.5rem; width: 100%;"></div>
