@using System.Linq
@model List<part1_poe.Models.view_claims>
@Html.Partial("_Menu")


<style>
    .btn-delete, .btn-cancel {
        padding: 5px 10px;
        border: none;
        cursor: pointer;
        border-radius: 5px;
        font-size: 13px;
        color: white;
    }

    .btn-delete {
        background-color: #e74c3c;
    }

    .btn-cancel {
        background-color: #f39c12;
        margin-right: 5px;
    }

    .btn-delete:hover {
        background-color: #c0392b;
    }

    .btn-cancel:hover {
        background-color: #d68910;
    }
    .track_claims_container {
        width: 97.6%;
        margin: 40px auto;
        background: #ffffff;
        padding: 20px;
        border-radius: 12px;
    }

    h2 {
        text-align: start;
        margin-bottom: 20px;
        color: #111827;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        background-color: #0b1f4a;
        color: #ffffff;
    }

        table thead {
            background-color: #06224d;
            color: #ffffff;
        }

        table th, table td {
            padding: 12px;
            text-align: center;
            border: none;
        }

        table tr:nth-child(even) {
            background-color: #122b64;
        }

    .status {
        font-weight: bold;
        padding: 6px 12px;
        border-radius: 6px;
    }

        .status.pending {
            color: #ffc107;
        }

        .status.approved {
            color: #28a745;
        }

        .status.rejected {
            color: #dc3545;
        }

        .status.finalized {
            color: #17a2b8;
        }

    .btn {
        padding: 6px 12px;
        text-decoration: none;
        background: #1e4fa3;
        color: white;
        border-radius: 6px;
        font-size: 14px;
    }

        .btn:hover {
            background: #3a74d8;
        }

    /* Footer */
    .footer {
        width: 95.6%;
        text-align: center;
        padding: 2rem;
        background-color: #0d1b2a;
        color: white;
        margin-top: 5rem;
    }

        .footer h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .footer p {
            font-size: 0.95rem;
            max-width: 800px;
            margin: 0 auto 1.5rem auto;
            color: #dbe2ef;
        }

        .footer .icons i {
            font-size: 1.2rem;
            margin: 0 10px;
            color: #3f88c5;
            transition: transform 0.3s, color 0.3s;
        }

            .footer .icons i:hover {
                transform: scale(1.2);
                color: #90e0ef;
            }

</style>
<div class="track_claims_container">
    <h2>Track Your Claims</h2>
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Sessions</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Total Amount</th>
                <th>Module</th>
                <th>Faculty</th>
                <th>Supporting Document</th>
                <th>Status</th>
                <th>Date Submitted</th>
                <th>Action</th> <!-- ✅ New column -->
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int i = 1;
                foreach (var claim in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@claim.NumberOfSessions</td>
                        <td>@claim.NumberOfHours</td>
                        <td>R @claim.Rate</td>
                        <td>R @claim.TotalAmount</td>
                        <td>@claim.ModuleName</td>
                        <td>@claim.FacultyName</td>
                        <td>
                            @if (!string.IsNullOrEmpty(claim.SupportingDocument))
                            {
                                <a href="@Url.Content("~/files/" + claim.SupportingDocument)"
                                   target="_blank"
                                   style="display:inline-block;
                              padding:6px 12px;
                              background-color:#046df6;
                              color:white;
                              border:none;
                              border-radius:5px;
                              text-decoration:none;
                              font-size:0.9rem;
                              transition:background-color 0.2s ease;">
                                    View
                                </a>
                            }
                            else
                            {
                                <span style="color: grey;">No file</span>
                            }
                        </td>

                        <td>
                            <span class="status @(claim.ClaimStatus.ToLower())">@claim.ClaimStatus</span>
                        </td>
                        <td>@claim.CreatingDate.ToString("yyyy-MM-dd")</td>

                        <td>
                            @if (claim.ClaimStatus.ToLower() == "pending")
                            {
                                <form asp-action="CancelClaim" asp-route-id="@claim.ClaimID" method="post" style="display:inline;">
                                    <button type="submit" class="btn-cancel">Cancel</button>
                                </form>
                            }
                            <form asp-action="DeleteClaim" asp-route-id="@claim.ClaimID" method="post" style="display:inline;">
                                <button type="submit" class="btn-delete">Delete</button>
                            </form>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="11" style="text-align:center;">No claims found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>




<!--footer-->
<div style="height: 6.5rem; width:100%;"></div>
<div class="footer">
    <hr />
    <h3>About Us</h3>
    <p>At LayeredLogic,<br> We transform visions into reality through web applications and unwavering commitment to excellence.<br></p>
    <div class="icons">
        <i class="fa-brands fa-facebook"></i>
        <i class="fa-brands fa-instagram"></i>
        <i class="fa-brands fa-linkedin"></i>
        <i class="fa-brands fa-telegram"></i>
    </div>
    <br />
    copyright <i class="fa-regular fa-copyright"></i> 2025, Contract Monthly Claim System (CMCS) | Created by Matlhaga Amogelang
</div>
