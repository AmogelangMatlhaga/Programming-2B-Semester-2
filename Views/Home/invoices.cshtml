        .footer h3 {
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .footer p {
            font-size: 0.95rem;
            max-width: 800px;
            margin: 0 auto 1.5rem auto;
            color: #dbe2ef;
        }

        .footer .icons i {
            font-size: 1.2rem;
            margin: 0 10px;
            color: #3f88c5;
            transition: transform 0.3s, color 0.3s;
        }

            .footer .icons i:hover {
                transform: scale(1.2);
                color: #90e0ef;
            }
</style>

