@using static part1_poe.Models.lecturers
@model List<UserModel>

@Html.Partial("_menu")

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<body>

@{
    int totalLecturers = Model.Count();
    int totalMale = Model.Count(l => l.Gender.ToLower() == "male");
    int totalFemale = Model.Count(l => l.Gender.ToLower() == "female");
    int totalOther = Model.Count(l => l.Gender.ToLower() == "other");
}

<div class="container mt-4">

    <h2 class="mb-4 text-primary fw-bold">Lecturers Summary</h2>

    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fa fa-users fa-2x text-primary mb-2"></i>
                <h5>Total Lecturers</h5>
                <p class="fs-4 fw-bold">@totalLecturers</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fa fa-mars fa-2x text-info mb-2"></i>
                <h5>Male Lecturers</h5>
                <p class="fs-4 fw-bold">@totalMale</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fa fa-venus fa-2x text-danger mb-2"></i>
                <h5>Female Lecturers</h5>
                <p class="fs-4 fw-bold">@totalFemale</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center p-3">
                <i class="fa fa-genderless fa-2x text-warning mb-2"></i>
                <h5>Other</h5>
                <p class="fs-4 fw-bold">@totalOther</p>
            </div>
        </div>
    </div>

    <h2 class="mb-4 text-primary fw-bold">Lecturers List</h2>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0 align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Surname</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lecturer in Model)
                    {
                        <tr>
                            <td>@lecturer.UserID</td>
                            <td>@lecturer.FullNames</td>
                            <td>@lecturer.Surname</td>
                            <td>@lecturer.Email</td>
                            <td>@lecturer.Gender</td>
                            <td>@lecturer.Date.ToShortDateString()</td>
                            <td>
                                <button class="btn btn-outline-primary btn-sm"
                                        onclick="openUpdatePopup('@lecturer.UserID',
                                                                        '@lecturer.FullNames',
                                                                        '@lecturer.Surname',
                                                                        '@lecturer.Email',
                                                                        '@lecturer.Gender')">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm"
                                        onclick="openDeletePopup('@lecturer.UserID', '@lecturer.FullNames')">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== Update Popup ==================== -->
<div class="modal fade" id="updatePopup" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg rounded-4 border-0">

            <form method="post" asp-controller="Home" asp-action="UpdateLecturer">
                <div class="modal-header bg-primary text-white rounded-top-4">
                    <h5 class="modal-title"><i class="fa fa-edit"></i> Update Lecturer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <input type="hidden" id="updateID" name="UserID" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" id="updateFullName" name="FullNames" class="form-control shadow-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Surname</label>
                            <input type="text" id="updateSurname" name="Surname" class="form-control shadow-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" id="updateEmail" name="Email" class="form-control shadow-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gender</label>
                            <select id="updateGender" name="Gender" class="form-select shadow-sm">
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-primary rounded-3">
                        <i class="fa fa-save me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">
                        <i class="fa fa-times me-1"></i> Cancel
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- ==================== Delete Popup ==================== -->
<div class="modal fade" id="deletePopup" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4 border-0">

            <form method="get" asp-controller="Home" asp-action="DeleteLecturer">
                <div class="modal-header bg-danger text-white rounded-top-4">
                    <h5 class="modal-title"><i class="fa fa-trash"></i> Delete Lecturer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body text-center p-4">
                    <input type="hidden" id="deleteID" name="id" />
                    <p class="fs-6">Are you sure you want to delete <strong id="deleteName"></strong>?</p>
                    <p class="text-muted small">This action cannot be undone.</p>
                </div>

                <div class="modal-footer border-0 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">
                        <i class="fa fa-times me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-danger rounded-3">
                        <i class="fa fa-trash me-1"></i> Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function openUpdatePopup(id, fullName, surname, email, gender) {
        document.getElementById("updateID").value = id;
        document.getElementById("updateFullName").value = fullName;
        document.getElementById("updateSurname").value = surname;
        document.getElementById("updateEmail").value = email;
        document.getElementById("updateGender").value = gender;

        new bootstrap.Modal(document.getElementById("updatePopup")).show();
    }

    function openDeletePopup(id, name) {
        document.getElementById("deleteID").value = id;
        document.getElementById("deleteName").textContent = name;

        new bootstrap.Modal(document.getElementById("deletePopup")).show();
    }
</script>

</body>



